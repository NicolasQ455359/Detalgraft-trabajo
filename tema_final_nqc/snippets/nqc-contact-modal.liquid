<style>
@keyframes fadeInModalContact {
  from { opacity: 0; transform: scale(0.96); }
  to { opacity: 1; transform: scale(1); }
}
</style>

<script>
function openContactModal(e) {
  if (e) {
    try {
      e.preventDefault();
      e.stopPropagation();
    } catch(err) {}
  }
  var modal = document.getElementById('nqcContactModal');
  if (modal) {
    modal.style.display = 'flex';
    document.body.style.overflow = 'hidden';
  }
}

function closeContactModal(e) {
  if (e && e.target && e.target.id !== 'nqcContactModal' && !e.target.classList.contains('btn-close-contact') && e.type === 'click') {
    return;
  }
  var modal = document.getElementById('nqcContactModal');
  if (modal) {
    modal.style.display = 'none';
    document.body.style.overflow = '';
  }
}

function copyContactEmail() {
  var email = 'info@detalgraf.com';
  var btn = document.getElementById('btnCopyContactEmail');
  var icon = document.getElementById('copyIconEmail');
  var title = document.getElementById('copyTitleEmail');
  var desc = document.getElementById('copyDescEmail');
  var arrow = document.getElementById('copyArrowEmail');

  function updateUiSuccess() {
    if (icon) icon.textContent = '✅';
    if (title) {
      title.textContent = '¡Correo Copiado!';
      title.style.color = '#15803d';
    }
    if (desc) desc.textContent = 'info@detalgraf.com copiado al portapapeles listo para usar';
    if (arrow) {
      arrow.textContent = '¡Listo!';
      arrow.style.background = '#dcfce7';
      arrow.style.color = '#15803d';
    }
    if (btn) {
      btn.style.borderColor = '#86efac';
      btn.style.background = '#f0fdf4';
    }

    if (typeof showToastNotification === 'function') {
      showToastNotification(0, '✓ Correo copiado: info@detalgraf.com', 0, false);
    }

    setTimeout(function() {
      if (icon) icon.textContent = '📋';
      if (title) {
        title.textContent = 'Copiar correo: info@detalgraf.com';
        title.style.color = '#1e293b';
      }
      if (desc) desc.textContent = 'Copiar dirección al portapapeles para pegarla en cualquier cliente';
      if (arrow) {
        arrow.textContent = 'Copiar';
        arrow.style.background = '#e2e8f0';
        arrow.style.color = '#64748b';
      }
      if (btn) {
        btn.style.borderColor = '#cbd5e1';
        btn.style.background = '#f8fafc';
      }
    }, 3000);
  }

  if (navigator.clipboard && navigator.clipboard.writeText) {
    navigator.clipboard.writeText(email).then(updateUiSuccess).catch(function() {
      fallbackCopyText(email, updateUiSuccess);
    });
  } else {
    fallbackCopyText(email, updateUiSuccess);
  }
}

function fallbackCopyText(text, callback) {
  var textArea = document.createElement("textarea");
  textArea.value = text;
  textArea.style.position = "fixed";
  textArea.style.top = "0";
  textArea.style.left = "0";
  textArea.style.width = "2em";
  textArea.style.height = "2em";
  textArea.style.padding = "0";
  textArea.style.border = "none";
  textArea.style.outline = "none";
  textArea.style.boxShadow = "none";
  textArea.style.background = "transparent";
  document.body.appendChild(textArea);
  textArea.focus();
  textArea.select();
  try {
    document.execCommand('copy');
    if (callback) callback();
  } catch (err) {}
  document.body.removeChild(textArea);
}

// Alias para compatibilidad con código existente
window.openContactModal = openContactModal;
window.openContactMail = openContactModal;
window.closeContactModal = closeContactModal;
window.copyContactEmail = copyContactEmail;

// Cerrar con Escape
document.addEventListener('keydown', function(evt) {
  if (evt.key === 'Escape' || evt.keyCode === 27) {
    closeContactModal();
  }
});
</script>
