<div class="cart-drawer-overlay" id="cartDrawerOverlay" onclick="closeCartDrawer(event)">
  <div class="cart-drawer-panel" onclick="event.stopPropagation()">
    <div class="drawer-header">
      <div class="drawer-header-title" id="drawerHeaderTitle">Tu Carrito (0 productos)</div>
      <button class="drawer-close-btn" onclick="closeCartDrawer()" type="button" aria-label="Cerrar carrito">✕</button>
    </div>

    <div class="drawer-body">
      <!-- BARRA DE PEDIDO MÍNIMO BOGOTÁ / NACIONAL (ULTRA COMPACTA Y RESPONSIVE) -->
      <div class="min-order-card" id="minOrderCardContainer">
        <div class="min-toggle-row">
          <button type="button" class="min-toggle-btn active" id="btnZoneBog" onclick="setCartZone(100000)">
            📍 Bogotá ($100k Mínimo)
          </button>
          <button type="button" class="min-toggle-btn" id="btnZoneNac" onclick="setCartZone(200000)">
            🚚 Nacional ($200k Mínimo)
          </button>
        </div>

        <div class="min-progress-track">
          <div class="min-progress-bar" id="drawerProgressBar"></div>
        </div>

        <div class="min-status-row">
          <span class="min-alert-text" id="drawerAlertText">🛒 Agrega productos para despacho</span>
          <span class="min-progress-percent-badge" id="drawerProgressPercent">0%</span>
        </div>
        <span id="drawerMilestoneMid" style="display:none;"></span>
        <span id="drawerMilestoneGoal" style="display:none;"></span>
      </div>

      <!-- LISTA DINÁMICA DE ITEMS EN CARRITO (PRIORIDAD VISUAL FRONTAL) -->
      <div id="drawerItemsList" class="drawer-items-container"></div>

      <!-- CROSS-SELL / SUGERENCIAS DINÁMICAS PARA COMPLETAR EL PEDIDO MÍNIMO -->
      <div id="drawerCrossSell"></div>
    </div>

    <!-- FOOTER DEL CARRITO DRAWER (ULTRA COMPACTO, ELEGANTE Y RESPONSIVE) -->
    <div class="drawer-footer">
      <div class="drawer-total-row">
        <div class="drawer-total-label-wrap">
          <span class="drawer-total-title">Total Pedido:</span>
          <span class="drawer-total-iva">✓ IVA incluido · Detalgraf</span>
        </div>
        <span class="drawer-total-val" id="drawerTotalText">$0 COP</span>
      </div>

      <!-- FORMULARIO NATIVO DE CHECKOUT DE SHOPIFY (CONEXIÓN EXACTA A PAGOS) -->
      <form id="nqcDrawerCartForm" action="{{ routes.cart_url }}" method="post" novalidate onsubmit="return handleDrawerCartSubmit(event)">
        <!-- CAMPOS DE IDENTIFICACIÓN DIAN COMPACTOS -->
        <div class="drawer-dian-box">
          <div class="drawer-dian-fields">
            <select id="tipoIdentificacionDrawer" name="attributes[Tipo de identificación]" class="drawer-dian-select" title="Tipo de documento">
              <option value="NIT" selected>NIT</option>
              <option value="CC">CC</option>
              <option value="CE">CE</option>
              <option value="PP">Pasaporte</option>
            </select>
            <input type="text" id="cedulaNitDrawer" name="attributes[Número de documento]" class="drawer-dian-input" placeholder="Número / NIT DIAN *" value="" required>
          </div>
          <div class="drawer-dian-hint">Para Facturación Electrónica DIAN y remisión oficial</div>
        </div>

        <input type="hidden" name="attributes[Cédula / NIT DIAN]" id="nqcDrawerAttrCedulaDian" value="">
        <input type="hidden" name="attributes[Número de Guía]" id="nqcDrawerAttrGuia" value="">
        <input type="hidden" name="attributes[Zona Despacho]" id="nqcDrawerAttrZona" value="">
        <input type="hidden" name="note" id="nqcDrawerNote" value="">

        <!-- AUTORIZACIÓN MANEJO DE DATOS PERSONALES -->
        <div class="drawer-auth-row">
          <input type="checkbox" id="authDatosPersonalesDrawer" required checked>
          <label for="authDatosPersonalesDrawer">
            Acepto <a href="/policies/privacy-policy" target="_blank" rel="noopener">manejo de datos personales</a>
          </label>
        </div>

        <!-- ACCIONES SECUNDARIAS B2B: COTIZACIÓN PDF + COMPARTIR CARRITO (2 COLUMNAS) -->
        <div class="drawer-secondary-actions">
          <button type="button" class="btn-drawer-quote-pdf" id="btnDrawerQuotePdf" onclick="generateCartQuotePDF()" title="Descargar Cotización Oficial B2B en PDF">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
            </svg>
            <span>Cotización PDF</span>
          </button>

          <button type="button" class="btn-drawer-share-mail" id="btnDrawerShareMail" onclick="shareCartByEmail()" title="Compartir Carrito por Correo">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
            <span>Compartir</span>
          </button>
        </div>

        <!-- BOTÓN PRINCIPAL DE CHECKOUT -->
        <button type="submit" name="checkout" class="btn-drawer-checkout" id="btnCheckoutFigma">
          [ Proceder al Pago Seguro 🔒 ]
        </button>
      </form>

      <!-- BARRA INFERIOR DE CONFIANZA Y RASTREO -->
      <div class="drawer-footer-bottom">
        <span class="drawer-trust-text">🔒 Pasarela Oficial Shopify</span>
        <a href="#tracking" onclick="closeCartDrawer(); if(window.switchView){window.switchView('track');} return false;" class="drawer-track-link">
          📦 Rastrear Envío
        </a>
      </div>
    </div>
  </div>
</div>
