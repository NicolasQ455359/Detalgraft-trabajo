<div class="sticky-bottom-bar" id="stickyBottomBar" onclick="openCartDrawer()" style="cursor: pointer;">
  <div class="sticky-bar-left">
    <span class="sticky-bar-badge" id="stickyTotalBadge">0 Items</span>
    <span class="sticky-bar-total" id="stickyTotalPrice">$0 COP</span>
    <span class="sticky-bar-status" id="stickyStatusText">Agrega productos para despacho</span>
