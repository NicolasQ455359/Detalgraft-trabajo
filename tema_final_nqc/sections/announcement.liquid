{%- if section.settings.show_announcement -%}
<div id="announcement" data-section-id="{{ section.id }}" data-section-type="announcement-section" data-template="{{ template.name }}">
  <div class="wrapper">
    <div class="grid grid-small flex-nowrap align-center announcement-grid whitespace-nowrap fadeIn">
      <div class="grid__item three-twelfths flex announcement-item announcement-left overflow-hidden small--hide">
        {%- if section.settings.show_social -%}
          {%- render "social-medias" -%}
        {%- endif -%}
        {%- if section.settings.left_message -%}
          <span class="announcement-left-message rte">{{- section.settings.left_message -}}</span>
        {%- endif -%}
      </div>

      <div class="grid__item large-six-twelfths medium--six-twelfths announcement-item announcement-message overflow-hidden text-center{% if section.blocks.size > 1 %} slick slick-announcement{% endif %}"
        data-autoplayspeed="{{ section.settings.announcement_autoplayspeed | times: 1000 }}">
        {%- for block in section.blocks -%}
        <div class="announcement-message-item announcement-{{ block.id }} rte" {{ block.shopify_attributes }}>
          {%- unless block.settings.announcement_text == blank -%}
          {{ block.settings.announcement_text }}
          {%- endunless -%}
        </div>
        {%- endfor -%}
      </div>

      <div class="grid__item three-twelfths flex justify-end announcement-item announcement-right" style="position: relative; z-index: 9999; pointer-events: auto;">
        <a href="mailto:info@detalgraf.com" onclick="if(window.openContactMail){window.openContactMail(event);}else{window.open('https://mail.google.com/mail/?view=cm&fs=1&to=info@detalgraf.com&su=Contacto%20DetalShop%20-%20Detalgraf', '_blank'); return false;}" title="Escríbenos a info@detalgraf.com" style="color: #ffffff !important; text-decoration: none !important; display: inline-flex !important; align-items: center !important; gap: 6px !important; font-weight: 700 !important; font-size: 13px !important; cursor: pointer !important; position: relative !important; z-index: 9999 !important; pointer-events: auto !important;">
          <span>Contactanos</span>
          <span class="{{settings.icon}}" aria-hidden="true" style="font-size: 16px;">email</span>
        </a>
      </div>
    </div>
  </div>
</div>

<script>
if (!window.openContactMail) {
  window.openContactMail = function(e) {
    if (e) {
      try { e.preventDefault(); e.stopPropagation(); } catch(err){}
    }
    var modal = document.getElementById('nqcContactModal');
    if (modal) {
      modal.style.display = 'flex';
      document.body.style.overflow = 'hidden';
      return;
    }
    window.open('https://mail.google.com/mail/?view=cm&fs=1&to=info@detalgraf.com&su=Contacto%20DetalShop%20-%20Detalgraf', '_blank');
  };
}
</script>
{%- endif -%}

{% schema %}
  {
    "name": "Announcement",
	  "class": "announcement-section",
    "max_blocks": 5,
    "settings": [
      {
        "type": "checkbox",
        "id": "show_announcement",
        "label": "Enable announcement bar",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_social",
        "label": "Show social medias",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "email",
        "label":"Show email address",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "phone",
        "label":"Show phone number",
        "default": true
      },
      {
        "type": "richtext",
        "id": "left_message",
        "label": "Left message",
        "default": "<p>Follow us!</p>"
      },
      {
        "type": "richtext",
        "id": "right_message",
        "label": "Right message",
        "default": "<p>Get in touch with us</p>"
      },
      {
        "type": "header",
        "content": "Carousel options",
        "info": "Add more than one message to enable the carousel"
      },
      {
        "type": "range",
        "id": "announcement_autoplayspeed",
        "label": "Rotation speed",
        "min": 3,
        "max": 10,
        "step": 1,
        "unit": "s",
        "default": 5
      }
    ],
	  "blocks": [
	    {
        "type": "message",
        "name": "Message",
        "settings": [
          {
            "type": "richtext",
            "id": "announcement_text",
            "label": "Text",
            "default": "<p>Free shipping worldwide | 30-Day free returns</p>"
          }
        ]
      }
    ],
    "default": {
      "blocks": [
        {
          "type": "message"
        }
      ]
    }
  }
{% endschema %}