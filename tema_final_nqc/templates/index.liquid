        <script>
          // Sincronización automática de productos, precios y descuentos reales de la tienda Shopify
          window.SHOPIFY_STORE_PRODUCTS = [
            {%- for product in collections.all.products limit: 250 -%}
              {
                id: {{ product.id | json }},
                title: {{ product.title | json }},
                category: {{ product.type | default: "General" | json }},
                subcat: {{ product.type | default: "General" | json }},
                price: {{ product.price | divided_by: 100.0 }},
                compare_price: {% if product.compare_at_price > product.price %}{{ product.compare_at_price | divided_by: 100.0 }}{% else %}null{% endif %},
                image: {{ product.featured_image | image_url: width: 600 | json }},
                handle: {{ product.handle | json }},
                unit: "Unidad",
                rating: "4.8 ★★★★★ (25 clientes B2B)"
              }{%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          ];
        </script>

