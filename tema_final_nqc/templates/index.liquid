                  <path d="M181.9 256.4c-5.5-14.1-11.4-27.5-17.6-39.8-9.2-17.4-19.3-33.1-30.4-46.7-11.2-13.6-23.6-24.9-36.9-33.3C82.3 121.2 66.1 112 48 112c-17.7 0-32 14.3-32 32v96c0 17.7 14.3 32 32 32h20.1c3.7 0 7.1-1.2 10.1-3.4 8.2-6.1 20.2-9.4 35.8-9.4 12.3 0 22.2 2.1 29.7 6.3s12.5 10.7 15.2 19.4l.4 1.3 13.4 37.2-24.1 66.9-1.5 4.2c-3.5 9.6-7.4 17.2-11.7 22.8-4.3 5.6-8.6 9.5-12.7 11.6s-7.8 3.2-11.5 3.2H48c-17.7 0-32 14.3-32 32v16c0 17.7 14.3 32 32 32h88c24.7 0 44.5-10.7 59.1-31.9 14.7-21.3 27.6-51.3 38.4-89.3 10.9-38 19.5-81.7 25.7-129.8H352c17.7 0 32-14.3 32-32v-16c0-17.7-14.3-32-32-32H224V32c0-17.7-14.3-32-32-32H112c-17.7 0-32 14.3-32 32v80h72v64H64v-64h16v-80h160v80h-40v64h48c17.7 0 32 14.3 32 32v16c0 17.7-14.3 32-32 32h-66.1z"/>
                </svg>
                <span id="pdpFichaBtnText">Descargar Ficha Técnica Oficial (PDF)</span>
              </a>
              <button type="button" onclick="openPdfModal()" style="background:#f0f7ff; border:1px solid #bfdbfe; color:#004b87; width:100%; padding:10px 14px; border-radius:8px; font-size:12.5px; font-weight:700; cursor:pointer; display:flex; align-items:center; justify-content:center; gap:6px;">
                🔍 Ver Especificaciones Detalladas B2B
              </button>
            </div>
          </div>
        </div>

        <!-- BARRA INFERIOR DE RETORNO AL CATÁLOGO -->
        <div style="margin-top: 36px; padding-top: 20px; border-top: 1px solid #e2e8f0; display:flex; justify-content:space-between; align-items:center;">
          <button type="button" class="btn-pdp-back" onclick="switchView('home')">
            <span>←</span> Seguir Comprando en el Catálogo
          </button>
        </div>
      </div>
    </main>

    <!-- ====================================================================
         VISTA 3: PORTAL DE RASTREO (/TRACKING) — DISEÑO OFICIAL FIGMA
         CON PANEL DE ACTUALIZACIÓN GERENCIAL EN VIVO (WIX CMS)
         ==================================================================== -->
    <main id="viewTrack" class="page-view-block">
      <div class="tracking-view-wrapper">
        <div class="nqc-tracking-header">
          <h1 class="nqc-tracking-title">Centro de Seguimiento y Logística de Despachos</h1>
          <p class="nqc-tracking-subtitle">Consulta el estado de tu despacho institucional en tiempo real</p>
        </div>

        <!-- Formulario de Búsqueda -->
        <div class="nqc-search-box-wrapper">
          <div class="nqc-search-box">
            <span class="nqc-search-icon">📦</span>
            <input type="text" 
                   id="nqcTrackingInput" 
                   class="nqc-tracking-input" 
                   placeholder="Ingrese número de guía o factura (Ej: DTL-2026-8941)" 
                   value="" 
                   autocomplete="off">
            <button type="button" id="nqcBtnTrack" class="nqc-btn-track" onclick="doTrackingLookup()">
              Rastrear Envío
            </button>
          </div>
          <div class="nqc-quick-pills">
            <span style="font-size: 11.5px; font-weight: 800; color: #64748b;">Guías de ejemplo:</span>
            <button type="button" class="nqc-pill-btn" onclick="setAndTrackGuia('DTL-2026-8941')">DTL-2026-8941 (En Tránsito - Bogotá)</button>
            <button type="button" class="nqc-pill-btn" onclick="setAndTrackGuia('DTL-2026-1001')">DTL-2026-1001 (Entregado - Chía)</button>
            <button type="button" class="nqc-pill-btn" onclick="setAndTrackGuia('DTL-2026-9050')">DTL-2026-9050 (En Preparación)</button>
          </div>
        </div>

        {%- if customer and customer.orders.size > 0 -%}
        <div class="nqc-user-orders-banner" style="background:#f0fdf4; border:1.5px solid #86efac; border-radius:10px; padding:14px 18px; margin-bottom:20px; display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:10px;">
          <div>
            <span style="font-size:11px; font-weight:800; color:#15803d; text-transform:uppercase;">Usuario Conectado: {{ customer.first_name }} {{ customer.last_name }}</span>
            <h4 style="font-size:14px; font-weight:900; color:#0f172a; margin:2px 0 0 0;">Tus Pedidos Recientes Listos para Rastreo:</h4>
          </div>
          <div style="display:flex; gap:8px; flex-wrap:wrap;">
            {%- for order in customer.orders limit: 3 -%}
              <button type="button" class="nqc-pill-btn" onclick="setAndTrackGuia('{{ order.name }}')" style="background:#ffffff; border-color:#86efac; color:#166534; font-weight:800;">
                📦 {{ order.name }}
              </button>
            {%- endfor -%}
          </div>
        </div>
        {%- endif -%}

        <!-- Tarjeta de Resultados (Timeline Hi-Fi Figma) -->
        <div id="nqcTrackingResult" class="nqc-result-card" style="display: none;">
          <div class="nqc-result-header">
            <div>
              <div class="nqc-status-badge nqc-badge-transit" id="nqcStatusBadge">
                <span class="nqc-pulse-dot"></span>
                <span id="nqcStatusText">Pedido en tránsito</span>
              </div>
              <div class="nqc-order-meta">
                <span id="nqcFacturaText">Factura B2B #FE-8942</span>
                <span class="nqc-meta-sep">|</span>
                <span id="nqcTransportadoraText">Transportadora: Envía / Flota Detalgraf</span>
              </div>
              <div class="nqc-order-submeta">
                <span>Guía: <strong id="nqcGuiaText">DTL-2026-8941</strong></span>
                <span class="nqc-meta-sep">|</span>
                <span>Destino: <strong id="nqcDestinoText">Total Office SAS — Cra 45 # 108-20, Bogotá D.C.</strong></span>
              </div>
            </div>
            <button type="button" onclick="switchView('home')" style="background:#f1f5f9; color:#0f172a; border:1px solid #cbd5e1; padding:8px 16px; border-radius:8px; font-size:12.5px; font-weight:800; cursor:pointer; display:inline-flex; align-items:center; gap:6px;">
              ← Volver a la Tienda
            </button>
          </div>

          <!-- Stepper Gráfico de 4 Estados Con Iconos Oficiales Figma -->
          <div class="nqc-timeline-stepper">
            <!-- Paso 1: Confirmado -->
            <div class="nqc-step completed" id="nqcStep1">
              <div class="nqc-step-icon-top">
                <svg class="ds-svg ds-svg-step" width="22" height="22" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#1A4B8C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                  <polyline points="14 2 14 8 20 8"/>
                  <polyline points="8 13 11 16 16 10" stroke="#00A86B" stroke-width="2"/>
                </svg>
              </div>
              <div class="nqc-step-circle" id="nqcStepCirc1">✓</div>
              <div class="nqc-step-label">
                <strong>Confirmado</strong>
                <span id="nqcStep1Date">12 Jun · 08:30</span>
              </div>
            </div>
            <div class="nqc-step-line nqc-line-completed" id="nqcLine1"></div>

            <!-- Paso 2: En Preparación -->
            <div class="nqc-step completed" id="nqcStep2">
              <div class="nqc-step-icon-top">
                <svg class="ds-svg ds-svg-step" width="22" height="22" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#1A4B8C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
                  <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
                  <line x1="12" y1="22.08" x2="12" y2="12"/>
                  <path d="M7 11l3 3 6-6" stroke="#00A86B" stroke-width="2"/>
                </svg>
              </div>
              <div class="nqc-step-circle" id="nqcStepCirc2">✓</div>
              <div class="nqc-step-label">
                <strong>En Preparación</strong>
                <span id="nqcStep2Date">12 Jun · 10:15</span>
              </div>
            </div>
            <div class="nqc-step-line nqc-line-completed" id="nqcLine2"></div>

            <!-- Paso 3: En Tránsito (Activo) -->
            <div class="nqc-step active" id="nqcStep3">
              <div class="nqc-step-icon-top">
                <svg class="ds-svg ds-svg-step" width="22" height="22" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#1A4B8C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="1" y="5" width="13" height="10" rx="1"/>
                  <path d="M14 8h4l3 3v4h-7V8z"/>
                  <circle cx="5" cy="18" r="2" stroke="#00A86B"/>
                  <circle cx="16" cy="18" r="2" stroke="#00A86B"/>
                  <path d="M19 4a3 3 0 0 1 3 3c0 2-3 5-3 5s-3-3-3-5a3 3 0 0 1 3-3z" stroke="#00A86B" fill="#00A86B" transform="scale(0.6) translate(16, -2)"/>
                </svg>
              </div>
              <div class="nqc-step-circle" id="nqcStepCirc3"><div class="nqc-inner-active-dot"></div></div>
              <div class="nqc-step-label">
                <strong>En Tránsito</strong>
                <span id="nqcStep3Date">13 Jun · 07:45</span>
              </div>
            </div>
            <div class="nqc-step-line" id="nqcLine3"></div>

            <!-- Paso 4: Entregado -->
            <div class="nqc-step" id="nqcStep4">
              <div class="nqc-step-icon-top">
                <svg class="ds-svg ds-svg-step" width="22" height="22" viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#64748B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
                  <polyline points="22 4 12 14.01 9 11.01" stroke="#00A86B" stroke-width="2.5"/>
                </svg>
              </div>
              <div class="nqc-step-circle" id="nqcStepCirc4"></div>
              <div class="nqc-step-label">
                <strong>Entregado</strong>
                <span id="nqcStep4Date">Pendiente</span>
              </div>
            </div>
          </div>

          <!-- Historial Cronológico Detallado -->
          <div class="nqc-history-section">
            <h3 class="nqc-history-title">Historial Cronológico de Movimientos</h3>
            <ul class="nqc-history-list" id="nqcHistoryList">
              <li class="nqc-history-item nqc-item-active">
                <span class="nqc-history-bullet"></span>
                <span class="nqc-history-time">13 Sep · 07:45 AM</span>
                <span class="nqc-history-desc">— En despacho hacia Bogotá D.C. con vehículo propio N° 4 · Conductor: Carlos Mendoza</span>
              </li>
              <li class="nqc-history-item">
                <span class="nqc-history-bullet"></span>
                <span class="nqc-history-time">12 Sep · 10:15 PM</span>
                <span class="nqc-history-desc">— Recibido en centro de distribución y alistado para ruta de entrega</span>
              </li>
              <li class="nqc-history-item">
                <span class="nqc-history-bullet"></span>
                <span class="nqc-history-time">12 Sep · 08:30 AM</span>
                <span class="nqc-history-desc">— Pedido recibido y facturado con éxito (Factura B2B #FE-8942)</span>
              </li>
            </ul>
          </div>

          <!-- Botón de Asistencia WhatsApp -->
          <div class="nqc-whatsapp-action">
            <a id="nqcBtnWhatsappLogistic" 
               href="https://wa.me/573001234567?text=Hola%20Detalgraf,%20deseo%20informaci%C3%B3n%20sobre%20mi%20despacho%20con%20gu%C3%ADa%20DTL-2026-8941" 
               target="_blank" 
               rel="noopener" 
               class="nqc-btn-wa-full">
              <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
                <path d="M9.5 12h.01m2.5 0h.01m2.5 0h.01" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round"/>
              </svg>
              <span>Contactar al Conductor o Logística por WhatsApp</span>
            </a>
          </div>
        </div>

        <!-- Discreto disparador de autenticación para Gerencia -->
        <div id="gerenteAuthTriggerWrap" style="margin-top: 24px; text-align: center;">
          <button type="button" onclick="openGerenteAuthModal()" style="background: none; border: none; font-size: 11.5px; color: #94a3b8; cursor: pointer; text-decoration: underline; display: inline-flex; align-items: center; gap: 5px;">
            🔒 Acceso Gerencia (Actualizar Estados de Despacho)
          </button>
        </div>

        <!-- ==================================================================
             PANEL DE CONTROL GERENCIAL: ACTUALIZACIÓN DE ESTADOS EN VIVO
             (OCULTO POR DEFECTO: Solo accesible con PIN para el Jefe)
             ================================================================== -->
        <div id="gerenteControlPanel" class="gerente-control-panel" style="display: none;">
          <div style="display:flex; justify-content:space-between; align-items:flex-start; flex-wrap:wrap; gap:10px;">
            <div>
              <span class="gerente-panel-badge">👑 PANEL DE CONTROL GERENCIA / WIX CMS</span>
              <h3 class="gerente-panel-title">Actualizador de Estados de Despacho en Tiempo Real</h3>
              <p class="gerente-panel-subtitle">
                Los estados de cada pedido son administrados por el <strong>Gerente General / Director de Operaciones</strong>. Selecciona un estado para actualizar inmediatamente lo que ve el cliente:
              </p>
            </div>
            <div style="font-size:12px; color:#38bdf8; font-weight:700; background:rgba(56,189,248,0.1); border:1px solid rgba(56,189,248,0.3); padding:6px 12px; border-radius:8px;">
              Guía Activa: <span id="gerenteActiveGuiaTag" style="color:#ffffff;">DTL-2026-8941</span>
            </div>
          </div>

          <!-- Selector de Estado de 4 Pasos para el Gerente -->
          <div class="gerente-step-buttons">
            <button type="button" class="btn-gerente-step" id="btnGerenteStep1" onclick="gerenteSetStep(1)">
              🟡 1. Confirmado
            </button>
            <button type="button" class="btn-gerente-step" id="btnGerenteStep2" onclick="gerenteSetStep(2)">
              🟠 2. En Preparación
            </button>
            <button type="button" class="btn-gerente-step active-step" id="btnGerenteStep3" onclick="gerenteSetStep(3)">
              🔵 3. En Tránsito (Ruta)
            </button>
            <button type="button" class="btn-gerente-step" id="btnGerenteStep4" onclick="gerenteSetStep(4)">
              🟢 4. Entregado
            </button>
          </div>

          <!-- Campo de Novedad / Nota oficial del Gerente -->
          <div class="gerente-novedad-row">
            <input type="text" 
                   id="gerenteNovedadInput" 
                   class="gerente-novedad-input" 
                   value="En despacho hacia Bogotá D.C. con vehículo propio N° 4 · Conductor: Carlos Mendoza" 
                   placeholder="Escribe la novedad o ubicación actual del envío...">
            <button type="button" class="btn-gerente-save" onclick="gerenteApplyUpdate()">
              💾 Aplicar Cambio como Gerente
            </button>
          </div>

          <div class="gerente-info-note">
            <span>ℹ️</span>
            <span>En producción, la Gerencia realiza este cambio en la colección <em>'Despachos'</em> de Wix Studio o desde la app móvil de Wix/Google Sheets, reflejándose en esta pantalla en menos de 1 segundo sin tocar código.</span>
          </div>
        </div>

        <!-- Modal PIN Exclusivo Gerente / Admin -->
        <div id="gerenteAuthModal" class="nqc-modal-overlay" style="display: none;" onclick="closeGerenteAuthModal(event)">
          <div class="nqc-modal-card" style="max-width: 420px; text-align: center; padding: 28px 24px; position: relative;" onclick="event.stopPropagation()">
            <button type="button" class="btn-modal-close-pin" onclick="closeGerenteAuthModal()" style="position: absolute; top: 12px; right: 14px; background: none; border: none; font-size: 20px; color: #94a3b8; cursor: pointer;">✕</button>
            <div style="font-size: 36px; margin-bottom: 8px;">🔐</div>
            <h3 style="font-size: 17px; font-weight: 800; color: #0f172a; margin-bottom: 6px;">Acceso Exclusivo de Gerencia</h3>
            <p style="font-size: 12.5px; color: #64748b; line-height: 1.4; margin-bottom: 18px;">
              Este módulo es de uso restringido para el Gerente General y Logística de Detalgraf para actualizar guías y estados en tiempo real.
            </p>
            <div style="margin-bottom: 14px; text-align: left;">
              <label style="display: block; font-size: 11.5px; font-weight: 700; color: #334155; margin-bottom: 6px;">Código PIN de Seguridad:</label>
              <input type="password" id="inputGerentePin" placeholder="Ingrese PIN (Ej: 2026)" maxlength="10" 
                     style="width: 100%; padding: 10px 14px; border: 1.5px solid #cbd5e1; border-radius: 8px; font-size: 14px; box-sizing: border-box; text-align: center; letter-spacing: 3px;"
                     onkeydown="if(event.key==='Enter') verifyGerentePin()">
              <div id="gerentePinError" style="display: none; color: #dc2626; font-size: 11.5px; font-weight: 700; margin-top: 6px; text-align: center;">
                ❌ PIN incorrecto. Acceso denegado.
              </div>
            </div>
            <div style="display: flex; gap: 10px; justify-content: center;">
              <button type="button" onclick="closeGerenteAuthModal()" style="padding: 9px 18px; border: 1px solid #cbd5e1; background: #f8fafc; border-radius: 8px; font-size: 12.5px; font-weight: 700; cursor: pointer; color: #475569;">
                Cancelar
              </button>
              <button type="button" onclick="verifyGerentePin()" style="padding: 9px 22px; border: none; background: #005091; color: #ffffff; border-radius: 8px; font-size: 12.5px; font-weight: 800; cursor: pointer; box-shadow: 0 2px 6px rgba(0,80,145,0.3);">
                Desbloquear Panel
              </button>
            </div>
          </div>
        </div>

      </div>
    </main>

    </div>
<div class="index-sections" style="display:none;">
  {{ content_for_index }}
</div>
