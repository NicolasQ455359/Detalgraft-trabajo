<!-- /templates/cart.liquid — Plantilla oficial del Carrito de DetalShop -->
<script>
  (function() {
    var search = window.location.search || '';
    var sep = search ? '&' : '?';
    if (search.indexOf('open_cart=true') === -1) {
      search = search + sep + 'open_cart=true';
    }
    window.location.replace('/' + search + '#cart');
  })();
</script>
<noscript>
  {% render "cart-page", cart: cart %}
</noscript>
<script async src="https://zooomyapps.com/agree/ZooomyCartTerms.js" data-shop="{{shop.permanent_domain}}" data-cart="{{ cart.item_count }}"></script>
