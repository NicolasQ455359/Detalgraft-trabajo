<!-- Section: nqc-guarantees.liquid — Beneficios y Garantías Institucionales B2B DetalShop (Mes 2) -->
<section class="nqc-guarantee-bar-section wrapper">
  <div class="nqc-guarantee-item">
    <div class="nqc-guarantee-icon">
      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="#1A4B8C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M1 3h14v13H1z"/>
        <path d="M15 8h4l3 3v5h-7V8z"/>
        <circle cx="5.5" cy="18.5" r="2.5" stroke="#00A86B" fill="#ffffff"/>
        <circle cx="17.5" cy="18.5" r="2.5" stroke="#00A86B" fill="#ffffff"/>
        <line x1="1" y1="19" x2="3" y2="19"/>
        <line x1="8" y1="19" x2="15" y2="19"/>
      </svg>
    </div>
    <div>
      <div class="nqc-guarantee-title">Envío Gratis Aplicable</div>
      <div class="nqc-guarantee-desc">En pedidos superiores a $100.000 Bogotá y $200.000 a nivel Nacional.</div>
    </div>
  </div>

  <div class="nqc-guarantee-item">
    <div class="nqc-guarantee-icon">
      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="#1A4B8C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="12" cy="13" r="9"/>
        <polyline points="12 8 12 13 15 15"/>
        <path d="M12 4V1"/>
        <path d="M9 1h6"/>
        <polygon points="19 6 15 11 18 11 16 16 21 10 18 10 19 6" stroke="#00A86B" fill="#00A86B" stroke-width="1"/>
      </svg>
    </div>
    <div>
      <div class="nqc-guarantee-title">Entregas en 24 a 48 Horas</div>
      <div class="nqc-guarantee-desc">Despacho con flota propia para Bogotá y transportadoras aliadas nacional.</div>
    </div>
  </div>

  <div class="nqc-guarantee-item">
    <div class="nqc-guarantee-icon">
      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="#1A4B8C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
        <polyline points="9 12 11 14 15 10" stroke="#00A86B" stroke-width="2.2"/>
      </svg>
    </div>
    <div>
      <div class="nqc-guarantee-title">Facturación DIAN Legal</div>
      <div class="nqc-guarantee-desc">Emisión inmediata con Cédula o NIT para su contabilidad empresarial.</div>
    </div>
  </div>

  <div class="nqc-guarantee-item">
    <div class="nqc-guarantee-icon">
      <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="#1A4B8C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
        <path d="M9.5 12h.01m2.5 0h.01m2.5 0h.01" stroke="#00A86B" stroke-width="2.5" stroke-linecap="round"/>
      </svg>
    </div>
    <div>
      <div class="nqc-guarantee-title">Soporte Corporativo</div>
      <div class="nqc-guarantee-desc">Asesor asignado en WhatsApp para cotizaciones por estiba o volumen.</div>
    </div>
  </div>
</section>

