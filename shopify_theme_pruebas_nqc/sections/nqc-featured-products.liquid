      <div class="nqc-catalog-search-wrap">
        <span class="nqc-catalog-search-icon">🔍</span>
        <input type="text" id="nqcCatalogSearchInput" oninput="nqcSearchCatalog(this.value)" placeholder="Buscar por producto, SKU o categoría...">
      </div>
    </div>

    <!-- TABS DE CATEGORÍA -->
