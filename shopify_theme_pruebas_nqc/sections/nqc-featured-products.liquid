.nqc-btn-card-view:hover { border-color: #1a4b8c; color: #1a4b8c; background: #eff6ff; }
</style>

<script>
function nqcFilterCatalog(category, btn) {
  if (btn) {
    document.querySelectorAll('.nqc-catalog-tab-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
  }
  const cards = document.querySelectorAll('.nqc-product-catalog-card');
  cards.forEach(card => {
    const cardCat = card.getAttribute('data-category');
    if (category === 'Todos' || cardCat === category) {
      card.style.display = 'flex';
    } else {
      card.style.display = 'none';
    }
  });
}

function nqcSearchCatalog(query) {
  const q = query.toLowerCase().trim();
  const cards = document.querySelectorAll('.nqc-product-catalog-card');
  cards.forEach(card => {
    const title = (card.querySelector('.nqc-card-title')?.textContent || '').toLowerCase();
    const sku = (card.querySelector('.nqc-card-sku')?.textContent || '').toLowerCase();
    const cat = (card.getAttribute('data-category') || '').toLowerCase();
    if (!q || title.includes(q) || sku.includes(q) || cat.includes(q)) {
      card.style.display = 'flex';
    } else {
      card.style.display = 'none';
    }
  });
}

function nqcQuickAdd(id, title, price) {
  if (typeof theme !== 'undefined' && theme.cart) {
    // Standard Debutify Cart Add
    const formData = {
      'items': [{
        'id': id,
        'quantity': 1
      }]
    };
    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(formData)
    }).then(res => res.json()).then(data => {
      document.dispatchEvent(new CustomEvent('theme:cart:updated'));
    }).catch(err => {
      console.log('Cart add:', err);
    });
  }
  alert('Producto agregado al carrito institucional: ' + title);
}
</script>

