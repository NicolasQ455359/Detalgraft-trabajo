/* ==========================================================================
   ESTILOS CORPORATIVOS B2B DETALSHOP (MES 2)
   Hero Banner, Galería 4 Vistas, Colores de Marca y Micro-interacciones
   ========================================================================== */
:root {
  --nqc-primary: #1a4b8c;
  --nqc-primary-hover: #123666;
  --nqc-success: #00a86b;
  --nqc-success-hover: #008f5b;
  --nqc-slate-900: #0f172a;
}

/* Ocultar galería por defecto de Debutify cuando esté activa la galería B2B */
.nqc-pdp-gallery-container ~ .product-single__media-group-wrapper {
  display: none !important;
}

/* 1. HERO BANNER B2B INSTITUCIONAL */
.nqc-b2b-hero-banner {
  background: linear-gradient(135deg, #0b1528 0%, #1a4b8c 55%, #005091 100%);
  color: #ffffff;
  padding: 44px 20px 36px 20px;
  position: relative;
  overflow: hidden;
  margin-bottom: 30px;
}
.nqc-b2b-hero-banner::after {
  content: '';
  position: absolute;
  top: -30%;
  right: -10%;
  width: 480px;
  height: 480px;
  background: radial-gradient(circle, rgba(0, 168, 107, 0.22) 0%, rgba(26, 75, 140, 0.05) 60%, transparent 80%);
  border-radius: 50%;
  pointer-events: none;
}
.nqc-hero-container {
  position: relative;
  z-index: 2;
  max-width: 1100px;
  margin: 0 auto;
}
.nqc-hero-badge-pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  background: rgba(255, 255, 255, 0.12);
  backdrop-filter: blur(8px);
  border: 1px solid rgba(255, 255, 255, 0.2);
  color: #a7f3d0;
  font-size: 11px;
  font-weight: 800;
  padding: 6px 14px;
  border-radius: 20px;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin-bottom: 14px;
}
.nqc-hero-title-main {
  font-size: 34px;
  font-weight: 900;
  line-height: 1.15;
  letter-spacing: -0.03em;
  margin-bottom: 12px;
  color: #ffffff !important;
}
.nqc-hero-title-main span { color: #34d399 !important; }
.nqc-hero-description {
  font-size: 15px;
  line-height: 1.55;
  color: #cbd5e1;
  margin-bottom: 24px;
  max-width: 760px;
}
.nqc-hero-actions-row {
  display: flex;
  gap: 14px;
  flex-wrap: wrap;
  align-items: center;
  margin-bottom: 28px;
}
.nqc-btn-hero-cta {
  background: #00a86b !important;
  color: #ffffff !important;
  padding: 12px 24px !important;
  border-radius: 8px !important;
  font-weight: 800 !important;
  font-size: 14px !important;
  display: inline-flex !important;
  align-items: center !important;
  gap: 8px !important;
  box-shadow: 0 4px 14px rgba(0, 168, 107, 0.35) !important;
  border: none !important;
}
.nqc-btn-hero-cta:hover { background: #008f5b !important; transform: translateY(-2px); }
.nqc-btn-hero-secondary {
  background: rgba(255, 255, 255, 0.12) !important;
  color: #ffffff !important;
  padding: 12px 22px !important;
  border-radius: 8px !important;
  font-weight: 700 !important;
  font-size: 14px !important;
  display: inline-flex !important;
  align-items: center !important;
  gap: 8px !important;
  border: 1px solid rgba(255, 255, 255, 0.25) !important;
}
.nqc-btn-hero-secondary:hover { background: rgba(255, 255, 255, 0.22) !important; }
.nqc-hero-metrics-bar {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16px;
  border-top: 1px solid rgba(255, 255, 255, 0.15);
  padding-top: 20px;
}
.nqc-metric-box { display: flex; flex-direction: column; }
.nqc-metric-value { font-size: 20px; font-weight: 900; color: #ffffff; letter-spacing: -0.02em; }
.nqc-metric-label { font-size: 11.5px; color: #94a3b8; font-weight: 600; margin-top: 2px; }

/* 2. GALERÍA 4 VISTAS B2B EN SHOPIFY PDP */
.nqc-pdp-gallery-container {
  display: flex;
  flex-direction: column;
  gap: 14px;
  margin-bottom: 24px;
}
.nqc-main-frame {
  width: 100%;
  height: 460px;
  background: #ffffff;
  border: 1.5px solid #e2e8f0;
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
  transition: all 0.2s ease;
}
.nqc-main-frame:hover { border-color: #1a4b8c; box-shadow: 0 8px 24px rgba(26, 75, 140, 0.1); }
.nqc-main-img {
  max-width: 86%;
  max-height: 86%;
  object-fit: contain;
  transition: transform 0.35s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.2s ease, filter 0.3s ease;
}
.nqc-main-frame:hover .nqc-main-img { transform: scale(1.04); }

.nqc-main-img.view-perspective-3d {
  transform: perspective(700px) rotateY(-18deg) rotateX(4deg) scale(0.92);
  filter: drop-shadow(18px 18px 25px rgba(0,0,0,0.3));
}
.nqc-main-img.view-macro-label {
  transform: scale(1.6) translateY(-5%);
  filter: contrast(1.15) brightness(1.02);
}
.nqc-main-img.view-pallet-estiba {
  transform: scale(0.85) translateY(-6%);
  filter: drop-shadow(0 20px 20px rgba(0,0,0,0.35));
}

.nqc-bestseller-badge {
  position: absolute;
  top: 14px;
  left: 14px;
  background: #fffbeb;
  border: 1px solid #fef3c7;
  color: #b45309;
  font-size: 11px;
  font-weight: 800;
  padding: 5px 11px;
  border-radius: 6px;
  z-index: 5;
}
.nqc-active-view-tag {
  position: absolute;
  bottom: 14px;
  left: 14px;
  background: rgba(15, 23, 42, 0.88);
  backdrop-filter: blur(6px);
  color: #ffffff;
  font-size: 11px;
  font-weight: 700;
  padding: 5px 11px;
  border-radius: 6px;
  display: flex;
  align-items: center;
  gap: 6px;
  z-index: 5;
}
.nqc-zoom-hint {
  position: absolute;
  bottom: 14px;
  right: 14px;
  background: rgba(255, 255, 255, 0.94);
  border: 1px solid #cbd5e1;
  color: #334155;
  font-size: 10.5px;
  font-weight: 700;
  padding: 5px 10px;
  border-radius: 6px;
  display: flex;
  align-items: center;
  gap: 5px;
  z-index: 5;
}

.nqc-thumbnail-row {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 10px;
}
.nqc-thumb-card {
  height: 90px;
  border: 2px solid #e2e8f0;
  border-radius: 8px;
  background: #ffffff;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 6px 4px;
  cursor: pointer;
  position: relative;
  overflow: hidden;
  transition: all 0.2s ease;
}
.nqc-thumb-card img {
  width: 100%;
  height: 54px;
  object-fit: contain;
}
.nqc-thumb-label {
  font-size: 10px;
  font-weight: 700;
  color: #475569;
  text-align: center;
  white-space: nowrap;
  text-overflow: ellipsis;
  overflow: hidden;
  max-width: 100%;
}
.nqc-thumb-card:hover {
  border-color: #1a4b8c;
  transform: translateY(-2px);
}
.nqc-thumb-card.active {
  border-color: #1a4b8c;
  background: #eff6ff;
  box-shadow: 0 0 0 2px rgba(26, 75, 140, 0.2);
}
.nqc-thumb-card.active .nqc-thumb-label {
  color: #1a4b8c;
  font-weight: 800;
}
.nqc-thumb-badge-auto {
  position: absolute;
  top: 2px;
  right: 2px;
  background: #0284c7;
  color: #ffffff;
  font-size: 8px;
  font-weight: 800;
  padding: 1px 3px;
  border-radius: 3px;
  text-transform: uppercase;
}

@media (max-width: 768px) {
  .nqc-hero-title-main { font-size: 26px; }
  .nqc-hero-metrics-bar { grid-template-columns: repeat(2, 1fr); }
  .nqc-main-frame { height: 350px; }
  .nqc-thumb-card { height: 75px; }
  .nqc-thumb-card img { height: 44px; }
}


