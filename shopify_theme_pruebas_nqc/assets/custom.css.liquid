  padding: 9px 14px;
  border-radius: 6px;
  font-size: 12px;
  font-weight: 700;
  text-decoration: none;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  transition: all 0.2s;
}
.nqc-btn-pdf-dl:hover { background: #eff6ff; border-color: #1a4b8c; }

/* 5. FOOTER CORPORATIVO B2B */
.nqc-site-footer {
  background: #0f172a;
  color: #ffffff;
  padding: 50px 0 24px 0;
  margin-top: 40px;
  border-top: 3px solid #1a4b8c;
}
.nqc-footer-grid {
  display: grid;
  grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
  gap: 36px;
  margin-bottom: 36px;
}
.nqc-footer-logo-main {
  font-size: 26px;
  font-weight: 900;
  color: #ffffff;
  letter-spacing: -0.03em;
}
.nqc-footer-logo-main span { color: #00a86b; }
.nqc-footer-col h4 {
  font-size: 14px;
  font-weight: 800;
  color: #ffffff;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-bottom: 14px;
}
.nqc-footer-col ul { list-style: none; padding: 0; margin: 0; }
.nqc-footer-col ul li { margin-bottom: 8px; }
.nqc-footer-col ul li a {
  color: #94a3b8;
  font-size: 13px;
  text-decoration: none;
  transition: color 0.2s;
}
.nqc-footer-col ul li a:hover { color: #38bdf8; }
.nqc-footer-bottom {
  border-top: 1px solid #1e293b;
  padding-top: 20px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 12px;
  color: #64748b;
  flex-wrap: wrap;
  gap: 12px;
}

@media (max-width: 900px) {
  .nqc-guarantee-bar-section { grid-template-columns: repeat(2, 1fr); }
  .nqc-lines-grid { grid-template-columns: repeat(2, 1fr); }
  .nqc-crossell-grid { grid-template-columns: repeat(2, 1fr); }
  .nqc-pdp-grid { grid-template-columns: 1fr; }
  .nqc-footer-grid { grid-template-columns: 1fr; gap: 24px; }
}
