</style>

<script>
(function() {
  // Datos del producto inyectados desde Shopify Liquid
  var productVariants = {{ product.variants | json }};
  var productTitle = {{ product.title | json }};
  var currentVariantId = {{ product.selected_or_first_available_variant.id }};
  var basePriceInCents = {{ product.selected_or_first_available_variant.price }};

  // Función formateadora de moneda en Pesos Colombianos (COP)
  function formatCOP(cents) {
    var pesos = Math.round(cents / 100);
    return pesos.toLocaleString('es-CO');
  }

  function getActiveVariantPrice() {
    var select = document.querySelector('select[name="id"]');
    if (select && select.value) {
      var found = productVariants.find(function(v) { return String(v.id) === String(select.value); });
      if (found) return found.price;
    }
    return basePriceInCents;
  }

  function getSelectedQuantity() {
    var qtyInput = document.querySelector('input[name="quantity"]') || 
                   document.querySelector('.qty-input') || 
                   document.querySelector('#Quantity-product-' + {{ product.id }});
    if (qtyInput) {
      var parsed = parseInt(qtyInput.value, 10);
      return (isNaN(parsed) || parsed < 1) ? 1 : parsed;
    }
    return 1;
  }

  function updateDynamicPrice() {
    var priceEl = document.getElementById('nqc-dynamic-price-value');
    var formulaEl = document.getElementById('nqcSubtotalFormula');
    var waBtn = document.getElementById('nqcBtnVolumeQuote');
    if (!priceEl) return;

    var unitPriceCents = getActiveVariantPrice();
    var quantity = getSelectedQuantity();
    var totalCents = unitPriceCents * quantity;

    priceEl.classList.add('updating');
    setTimeout(function() {
      priceEl.textContent = formatCOP(totalCents);
      if (formulaEl) {
        formulaEl.textContent = '(' + quantity + ' un. × $' + formatCOP(unitPriceCents) + ')';
      }
      priceEl.classList.remove('updating');
    }, 80);

    // Actualizar enlace dinámico de WhatsApp con la cantidad seleccionada
    if (waBtn) {
      var phone = "573001234567";
      var msg = encodeURIComponent("Hola DetalShop, deseo cotizar por volumen el producto: " + productTitle + " (Cantidad: " + quantity + " unidades)");
      waBtn.href = "https://wa.me/" + phone + "?text=" + msg;
    }
  }

  function attachListeners() {
    // Escuchar inputs de cantidad
    document.querySelectorAll('input[name="quantity"], .qty-input').forEach(function(input) {
      input.addEventListener('input', updateDynamicPrice);
      input.addEventListener('change', updateDynamicPrice);
      input.addEventListener('keyup', updateDynamicPrice);
    });

    // Escuchar clics en botones de incremento y decremento
    document.querySelectorAll('.qty-adjust, .qty-plus, .qty-minus, .js-qty__adjust--plus, .js-qty__adjust--minus').forEach(function(btn) {
      btn.addEventListener('click', function() {
        setTimeout(updateDynamicPrice, 50);
      });
    });

    // Escuchar cambios de variante
    var variantSelect = document.querySelector('select[name="id"]');
    if (variantSelect) {
      variantSelect.addEventListener('change', updateDynamicPrice);
    }

    // Escuchar radios de variante si existen
    document.querySelectorAll('.single-option-selector__radio, input[type="radio"][name^="option"]').forEach(function(radio) {
      radio.addEventListener('change', function() {
        setTimeout(updateDynamicPrice, 100);
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() {
      attachListeners();
      updateDynamicPrice();
    });
  } else {
    attachListeners();
    updateDynamicPrice();
  }
})();
</script>
