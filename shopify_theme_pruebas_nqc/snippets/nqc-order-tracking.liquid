  100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(37, 99, 235, 0); }
}

.nqc-order-meta {
  font-size: 14px;
  font-weight: 600;
  color: #334155;
  margin-bottom: 4px;
}

.nqc-order-submeta {
  font-size: 13px;
  color: #64748b;
}

.nqc-meta-sep {
  margin: 0 8px;
  color: #cbd5e1;
}

/* Stepper Visual */
.nqc-timeline-stepper {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 32px 0 36px 0;
  position: relative;
}

.nqc-step {
  display: flex;
  flex-direction: column;
