<script>
document.addEventListener("DOMContentLoaded", function() {
  const input = document.getElementById("nqcTrackingInput");
  const btn = document.getElementById("nqcBtnTrack");
  const resultCard = document.getElementById("nqcTrackingResult");
  const errorCard = document.getElementById("nqcTrackingError");
  const waBtn = document.getElementById("nqcBtnWhatsappLogistic");

  // Base de datos de prueba con órdenes simuladas y realistas
  const simulatedOrders = {
    "DTL-2026-8941": {
      status: "Pedido en tránsito",
      badgeClass: "nqc-badge-transit",
      factura: "Factura B2B #FE-8942",
      transportadora: "Envía / Flota Detalgraf",
      guia: "0293848123",
      destino: "Bogotá D.C.",
      stepCompleted: 2, // 1: Confirmado, 2: Preparación, 3: Tránsito, 4: Entregado
      stepDates: ["12 Jun · 08:30", "12 Jun · 10:15", "13 Jun · 07:45", "Pendiente"],
      history: [
        { time: "13 Sep · 07:45 AM", desc: "— En despacho hacia Bogotá D.C.", active: true },
        { time: "12 Sep · 10:15 PM", desc: "— Recibido en centro de distribución Detalgraf", active: false },
        { time: "12 Sep · 08:30 AM", desc: "— Pedido recibido y facturado con éxito", active: false }
      ]
    },
    "FE-8942": {
      status: "Pedido en tránsito",
      badgeClass: "nqc-badge-transit",
      factura: "Factura B2B #FE-8942",
      transportadora: "Envía / Flota Detalgraf",
      guia: "0293848123",
      destino: "Bogotá D.C.",
      stepCompleted: 2,
      stepDates: ["12 Jun · 08:30", "12 Jun · 10:15", "13 Jun · 07:45", "Pendiente"],
      history: [
        { time: "13 Sep · 07:45 AM", desc: "— En despacho hacia Bogotá D.C.", active: true },
        { time: "12 Sep · 10:15 PM", desc: "— Recibido en centro de distribución Detalgraf", active: false },
        { time: "12 Sep · 08:30 AM", desc: "— Pedido recibido y facturado con éxito", active: false }
      ]
    },
    "DTL-2026-1001": {
      status: "Pedido Entregado",
      badgeClass: "nqc-badge-delivered",
      factura: "Factura B2B #FE-8720",
      transportadora: "Flota Propia Detalgraf",
      guia: "0284729101",
      destino: "Chía, Cundinamarca",
      stepCompleted: 4,
      stepDates: ["10 Jun · 09:00", "10 Jun · 14:00", "11 Jun · 08:00", "11 Jun · 16:30"],
      history: [
        { time: "11 Jun · 04:30 PM", desc: "— Entregado a satisfacción en sede cliente", active: true },
        { time: "11 Jun · 08:00 AM", desc: "— En ruta con conductor asignado", active: false },
        { time: "10 Jun · 09:00 AM", desc: "— Orden confirmada y alistada", active: false }
      ]
    }
  };

  function doTrack() {
    const val = input.value.trim().toUpperCase();
    if (!val) {
      input.focus();
      return;
    }

    // Actualizar link de WhatsApp
    const phone = "573001234567"; // Teléfono oficial soporte Detalgraf
    const msg = encodeURIComponent(`Hola Detalgraf, deseo información sobre el despacho de mi orden: ${val}`);
    if (waBtn) waBtn.href = `https://wa.me/${phone}?text=${msg}`;
    const errWaBtn = document.getElementById("nqcBtnErrorWhatsapp");
    if (errWaBtn) errWaBtn.href = `https://wa.me/${phone}?text=${msg}`;

    if (simulatedOrders[val]) {
      const ord = simulatedOrders[val];
      errorCard.style.display = "none";
      resultCard.style.display = "block";

      document.getElementById("nqcStatusText").textContent = ord.status;
      document.getElementById("nqcFacturaText").textContent = ord.factura;
      document.getElementById("nqcTransportadoraText").textContent = `Transportadora: ${ord.transportadora}`;
      document.getElementById("nqcGuiaText").textContent = ord.guia;
      document.getElementById("nqcDestinoText").textContent = ord.destino;

      // Actualizar Fechas del stepper
      document.getElementById("nqcStep1Date").textContent = ord.stepDates[0];
      document.getElementById("nqcStep2Date").textContent = ord.stepDates[1];
      document.getElementById("nqcStep3Date").textContent = ord.stepDates[2];
      document.getElementById("nqcStep4Date").textContent = ord.stepDates[3];

      // Actualizar Historial
      const histList = document.getElementById("nqcHistoryList");
      histList.innerHTML = ord.history.map(h => `
        <li class="nqc-history-item ${h.active ? 'nqc-item-active' : ''}">
          <span class="nqc-history-bullet"></span>
          <span class="nqc-history-time">${h.time}</span>
          <span class="nqc-history-desc">${h.desc}</span>
        </li>
      `).join('');
    } else if (val.length >= 4) {
      // Orden genérica / Dinámica para cualquier guía ingresada
      errorCard.style.display = "none";
      resultCard.style.display = "block";

      document.getElementById("nqcStatusText").textContent = "Pedido en procesamiento";
      document.getElementById("nqcFacturaText").textContent = `Orden #${val}`;
      document.getElementById("nqcTransportadoraText").textContent = "Transportadora: Red Logística Detalgraf";
      document.getElementById("nqcGuiaText").textContent = val;
      document.getElementById("nqcDestinoText").textContent = "Colombia";
    } else {
      resultCard.style.display = "none";
      errorCard.style.display = "flex";
      document.getElementById("nqcErrorMsg").textContent = `El número "${val}" no es válido. Por favor verifique el dato en su confirmación de compra o comuníquese con despachos.`;
    }
  }

  if (btn) btn.addEventListener("click", doTrack);
  if (input) {
    input.addEventListener("keypress", function(e) {
      if (e.key === "Enter") {
        e.preventDefault();
        doTrack();
      }
    });
  }
});
</script>
