<!-- Snippet: nqc-order-tracking.liquid — Módulo Institucional de Rastreo Detalgraf & DetalShop (Mes 2) -->
<div class="nqc-tracking-container">
  <div class="nqc-tracking-header text-center">
    <h1 class="nqc-tracking-title">Centro de Seguimiento y Logística de Despachos</h1>
    <p class="nqc-tracking-subtitle">Consulta el estado de tu despacho institucional en tiempo real</p>
  </div>

  <!-- Formulario de Búsqueda -->
  <div class="nqc-search-box-wrapper">
    <div class="nqc-search-box">
      <span class="nqc-search-icon">📦</span>
      <input type="text" 
             id="nqcTrackingInput" 
             class="nqc-tracking-input" 
             placeholder="Ingrese número de guía o factura (Ej: DTL-2026-8941)" 
             value="DTL-2026-8941" 
             autocomplete="off">
      <button type="button" id="nqcBtnTrack" class="nqc-btn-track">
        Rastrear Envío
      </button>
    </div>
  </div>

  <!-- Contenedor de Alerta / Estado Vacío o Error -->
  <div id="nqcTrackingError" class="nqc-alert-card nqc-alert-warning" style="display: none;">
    <div class="nqc-alert-icon">⚠️</div>
    <div class="nqc-alert-content">
      <h4>Despacho en proceso de asignación</h4>
      <p id="nqcErrorMsg">No encontramos un despacho activo con el número ingresado. Es posible que tu orden haya sido generada recientemente o requiera verificación manual.</p>
      <a id="nqcBtnErrorWhatsapp" href="https://wa.me/573001234567" target="_blank" rel="noopener" class="nqc-btn-wa-compact">
        <span>💬</span> Consultar con Despachos en WhatsApp
      </a>
    </div>
  </div>

  <!-- Tarjeta de Resultados (Timeline Hi-Fi Figma) -->
  <div id="nqcTrackingResult" class="nqc-result-card" style="display: block;">
    <div class="nqc-result-header">
      <div class="nqc-status-badge nqc-badge-transit" id="nqcStatusBadge">
        <span class="nqc-pulse-dot"></span>
        <span id="nqcStatusText">Pedido en tránsito</span>
      </div>
      <div class="nqc-order-meta">
        <span id="nqcFacturaText">Factura B2B #FE-8942</span>
        <span class="nqc-meta-sep">|</span>
        <span id="nqcTransportadoraText">Transportadora: Envía / Flota Detalgraf</span>
      </div>
      <div class="nqc-order-submeta">
        <span>Guía: <strong id="nqcGuiaText">0293848123</strong></span>
        <span class="nqc-meta-sep">|</span>
        <span>Destino: <strong id="nqcDestinoText">Bogotá D.C.</strong></span>
      </div>
    </div>

      <!-- Stepper Gráfico de 4 Estados Con Iconos Oficiales -->
      <div class="nqc-timeline-stepper">
        <!-- Paso 1 -->
        <div class="nqc-step nqc-step-completed" id="nqcStep1">
          <div style="margin-bottom: 4px;">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#1A4B8C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
              <polyline points="14 2 14 8 20 8"/>
              <polyline points="8 13 11 16 16 10" stroke="#00A86B" stroke-width="2"/>
            </svg>
          </div>
          <div class="nqc-step-circle">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </div>
          <div class="nqc-step-label">
            <strong>Confirmado</strong>
            <span id="nqcStep1Date">12 Jun · 08:30</span>
          </div>
        </div>
        <div class="nqc-step-line nqc-line-completed" id="nqcLine1"></div>

        <!-- Paso 2 -->
        <div class="nqc-step nqc-step-completed" id="nqcStep2">
          <div style="margin-bottom: 4px;">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#1A4B8C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/>
              <polyline points="3.27 6.96 12 12.01 20.73 6.96"/>
              <line x1="12" y1="22.08" x2="12" y2="12"/>
              <path d="M7 11l3 3 6-6" stroke="#00A86B" stroke-width="2"/>
            </svg>
          </div>
          <div class="nqc-step-circle">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="20 6 9 17 4 12"></polyline>
            </svg>
          </div>
          <div class="nqc-step-label">
            <strong>En Preparación</strong>
            <span id="nqcStep2Date">12 Jun · 10:15</span>
          </div>
        </div>
        <div class="nqc-step-line nqc-line-completed" id="nqcLine2"></div>

        <!-- Paso 3 (Activo) -->
        <div class="nqc-step nqc-step-active" id="nqcStep3">
          <div style="margin-bottom: 4px;">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#1A4B8C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="1" y="5" width="13" height="10" rx="1"/>
              <path d="M14 8h4l3 3v4h-7V8z"/>
              <circle cx="5" cy="18" r="2" stroke="#00A86B"/>
              <circle cx="16" cy="18" r="2" stroke="#00A86B"/>
              <path d="M19 4a3 3 0 0 1 3 3c0 2-3 5-3 5s-3-3-3-5a3 3 0 0 1 3-3z" stroke="#00A86B" fill="#00A86B" transform="scale(0.6) translate(16, -2)"/>
            </svg>
          </div>
          <div class="nqc-step-circle">
            <div class="nqc-inner-active-dot"></div>
          </div>
          <div class="nqc-step-label">
            <strong>En Tránsito</strong>
            <span id="nqcStep3Date">13 Jun · 07:45</span>
          </div>
        </div>
        <div class="nqc-step-line" id="nqcLine3"></div>

        <!-- Paso 4 -->
        <div class="nqc-step nqc-step-pending" id="nqcStep4">
          <div style="margin-bottom: 4px;">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="#64748B" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/>
              <polyline points="22 4 12 14.01 9 11.01" stroke="#00A86B" stroke-width="2.5"/>
            </svg>
          </div>
          <div class="nqc-step-circle"></div>
          <div class="nqc-step-label">
            <strong>Entregado</strong>
            <span id="nqcStep4Date">Pendiente</span>
          </div>
        </div>
      </div>

    <!-- Historial Cronológico Detallado -->
    <div class="nqc-history-section">
      <h3 class="nqc-history-title">Historial cronológico</h3>
      <ul class="nqc-history-list" id="nqcHistoryList">
        <li class="nqc-history-item nqc-item-active">
          <span class="nqc-history-bullet"></span>
          <span class="nqc-history-time">13 Sep · 07:45 AM</span>
          <span class="nqc-history-desc">— En despacho hacia Bogotá D.C.</span>
        </li>
        <li class="nqc-history-item">
          <span class="nqc-history-bullet"></span>
          <span class="nqc-history-time">12 Sep · 10:15 PM</span>
          <span class="nqc-history-desc">— Recibido en centro de distribución Detalgraf</span>
        </li>
        <li class="nqc-history-item">
          <span class="nqc-history-bullet"></span>
          <span class="nqc-history-time">12 Sep · 08:30 AM</span>
          <span class="nqc-history-desc">— Pedido recibido y facturado con éxito</span>
        </li>
      </ul>
    </div>

    <!-- Botón de Asistencia WhatsApp -->
    <div class="nqc-whatsapp-action">
      <a id="nqcBtnWhatsappLogistic" 
         href="https://wa.me/573001234567?text=Hola%20Detalgraf,%20deseo%20informaci%C3%B3n%20sobre%20mi%20despacho%20con%20gu%C3%ADa%20DTL-2026-8941" 
         target="_blank" 
         rel="noopener" 
         class="nqc-btn-wa-full"
         style="display: flex; align-items: center; justify-content: center; gap: 8px;">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="#ffffff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 11.5a8.38 8.38 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.38 8.38 0 0 1-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.38 8.38 0 0 1 3.8-.9h.5a8.48 8.48 0 0 1 8 8v.5z"/>
          <path d="M9.5 12h.01m2.5 0h.01m2.5 0h.01" stroke="#ffffff" stroke-width="2.5" stroke-linecap="round"/>
        </svg>
        <span>Contactar al Conductor o Logística por WhatsApp</span>
      </a>
    </div>

    <div class="nqc-result-footer text-center">
      <small>Información actualizada para clientes Institucionales B2B</small>
    </div>
  </div>
</div>

<style>
/* ==========================================================================
   ESTILOS PORTAL DE RASTREO HI-FI DETALGRAF / DETALSHOP (MES 2)
   ========================================================================== */
.nqc-tracking-container {
